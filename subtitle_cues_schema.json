{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "subtitle_cues",
  "type": "object",
  "additionalProperties": false,
  "required": ["cues"],
  "properties": {
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "text_zh"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "text_zh": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    }
  }
}
