{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title_candidates",
    "recommended_title_index",
    "title_reasons",
    "tags",
    "tag_evidence",
    "description",
    "tid"
  ],
  "properties": {
    "title_candidates": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 6, "maxLength": 40 }
    },
    "recommended_title_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "title_reasons": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title_index", "evidence_ids", "reason"],
        "properties": {
          "title_index": { "type": "integer", "minimum": 0, "maximum": 4 },
          "evidence_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 20 }
    },
    "tag_evidence": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "evidence_ids"],
        "properties": {
          "tag": { "type": "string", "minLength": 1, "maxLength": 20 },
          "evidence_ids": {
            "type": "array",
            "minItems": 0,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "description": { "type": "string", "minLength": 60, "maxLength": 1000 },
    "tid": { "type": "integer", "minimum": 1, "maximum": 9999 }
  }
}
