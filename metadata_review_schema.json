{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["approved", "scores", "issues", "rewrite_instructions"],
  "properties": {
    "approved": { "type": "boolean" },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grounding", "relevance", "specificity", "chinese_naturalness", "appeal"],
      "properties": {
        "grounding": { "type": "integer", "minimum": 1, "maximum": 5 },
        "relevance": { "type": "integer", "minimum": 1, "maximum": 5 },
        "specificity": { "type": "integer", "minimum": 1, "maximum": 5 },
        "chinese_naturalness": { "type": "integer", "minimum": 1, "maximum": 5 },
        "appeal": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rewrite_instructions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
